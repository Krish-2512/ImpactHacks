# Frontend environment template — copy to .env.local for dev, .env.production for prod
# Vite only exposes variables starting with VITE_ to the browser bundle.

# Dev: point to local backend
VITE_API_URL=http://localhost:8000

# Prod: point to your deployed backend (set this in Vercel dashboard, not here)
# VITE_API_URL=https://agrow-backend.up.railway.app
