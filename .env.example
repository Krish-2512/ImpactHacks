# ── Backend environment template ─────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env — only commit this file.

# SQL database — user accounts (register / login / profile)
# Dev default: SQLite (no extra server needed, file created automatically)
DATABASE_URL=sqlite+aiosqlite:///./agrow_users.db
# Production (PostgreSQL): uncomment and fill in
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/agrow

# MongoDB Atlas — agent cycles, memory, notifications, marketplace
# https://cloud.mongodb.com (free M0 tier)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agrow

# JWT — generate a new key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq (free) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_POWER=llama-3.3-70b-versatile

# Qdrant — dev: use embedded (set path). prod: use cloud (set URL + key, clear path).
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agrow_knowledge

# Plant disease model (auto-downloaded ~14 MB on first request)
DISEASE_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Open-Meteo weather — default Guwahati. Change to your location.
WEATHER_LAT=26.1445
WEATHER_LON=91.7362

# Email notifications (optional)
# Gmail setup: Google Account → Security → 2-Step Verification → App passwords → create one
# Set EMAIL_NOTIFICATIONS_ENABLED=true to activate
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=Agrow Intelligence <your_gmail@gmail.com>
EMAIL_MIN_PRIORITY=high
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx